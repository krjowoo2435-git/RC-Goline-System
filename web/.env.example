# Supabase — Dashboard → Project Settings → API
# 이 파일을 복사해 .env.local 로 저장한 뒤 값을 채우세요.
# Vercel: Project Settings → Environment Variables 에 동일 키 등록

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# 공개 도메인 (데스크톱 업로드 기본값과 동일)
# NEXT_PUBLIC_SITE_URL=https://jijokrcrecord.kr

# (선택) 서비스 롤 — 서버 API 전용. 브라우저에 노출 금지.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# (선택) 데스크톱 업로드 보호. 설정 시 데스크톱도 같은 값을 환경변수로 넣으세요.
# RCGLS_UPLOAD_SECRET=change-me
